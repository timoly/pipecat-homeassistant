# Start the satellite at boot, as a user service:
#
#   mkdir -p ~/.config/systemd/user
#   cp pipecat-satellite.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now pipecat-satellite
#   sudo loginctl enable-linger "$USER"
#
# The last line is what makes it run without anyone logged in. Then:
#
#   systemctl --user status pipecat-satellite
#   journalctl --user-unit=pipecat-satellite -f
#
# A user service keeps the satellite as the user who owns the audio device and
# the configuration in ~/.config, with no root anywhere. It needs a wake word to
# be useful, since a service has no keyboard: set wake_word_model first.
[Unit]
Description=Pipecat Assist voice satellite
# Nothing is ordered after the network on purpose. A user service cannot wait
# for network-online.target, and it does not need to: the client reconnects with
# backoff, so starting before the link is up costs one retry.
StartLimitIntervalSec=0

[Service]
WorkingDirectory=%h/pipecat-homeassistant/clients/pi_satellite
ExecStart=%h/pipecat-homeassistant/clients/pi_satellite/.venv/bin/python satellite.py
# The journal reads stdout through a pipe, which Python would block-buffer.
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
